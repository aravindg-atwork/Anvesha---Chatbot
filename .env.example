# Google ADK backend (recommended). Run npm run api in a second terminal.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_MEDIA_MODEL=
# Google Drive OAuth: create a Web application client and enable the Drive API.
# Register this exact redirect URI in Google Cloud. These are separate from GOOGLE_API_KEY.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/drive/callback
# Optional Fernet key; otherwise a separate encryption key is persisted in the data volume.
ANVESHA_TOKEN_KEY=
ANVESHA_API_URL=http://127.0.0.1:8000
QDRANT_URL=http://127.0.0.1:6333
OCR_LANGUAGES=eng
# For a host Python install, set TESSERACT_CMD if tesseract is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Legacy optional provider when ANVESHA_API_URL is unset.
# These variables are read only by the local server (server/chatApi.ts) and are
# never sent to the browser. Do not prefix them with VITE_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
